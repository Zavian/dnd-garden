{# This runs on every published note's <head>, right after title/tags. #}
{# Loads medium-zoom from a CDN and initializes it against all content images. #}

<script src="https://cdn.jsdelivr.net/npm/medium-zoom@1/dist/medium-zoom.min.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Targets images rendered inside the theme's <picture> wrapper,
    // which is how all embedded images are output on this site.
    mediumZoom('picture img', {
      margin: 24,
      background: 'rgba(10, 10, 10, 0.9)',
      scrollOffset: 0,
    });
  });
</script>

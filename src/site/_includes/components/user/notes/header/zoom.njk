{# This runs on every published note's <head>, right after title/tags. #}
{# Loads medium-zoom from a CDN and initializes it against all content images. #}

<script src="https://cdn.jsdelivr.net/npm/medium-zoom@1/dist/medium-zoom.min.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Targets images inside the main note content area.
    // Adjust the selector if your theme wraps content differently.
    mediumZoom('.note-content img, article img, .markdown-body img', {
      margin: 24,
      background: 'rgba(10, 10, 10, 0.9)',
      scrollOffset: 0,
    });
  });
</script>
